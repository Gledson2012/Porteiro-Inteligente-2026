# Segredo usado para assinar os JWTs da API. Gere um valor aleatório com pelo
# menos 32 caracteres e use um valor diferente em cada ambiente.
SECRET_KEY=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Chave privada RSA correspondente à chave pública em OfflineCryptoHelper.kt.
# Em produção, prefira QR_PRIVATE_KEY_FILE ou o segredo do provedor.
QR_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\ncole-aqui-a-chave\n-----END PRIVATE KEY-----

# Compatibilidade temporária com QR Codes antigos. Remova após a migração.
LEGACY_QR_KEY=

# SQLite só deve ser usado com caminho persistente fora da Vercel.
# DATABASE_PATH=/caminho/para/porteiro_inteligente.db

# Permitido apenas em desenvolvimento/testes locais; causa perda de dados em
# ambientes serverless e não deve ser ativado em produção.
ALLOW_EPHEMERAL_DATABASE=false

# Lista separada por vírgula de origens permitidas pela API.
CORS_ORIGINS=https://porteiro-inteligente-2026.vercel.app
PUBLIC_ORIGIN=https://porteiro-inteligente-2026.vercel.app

# Confie em X-Forwarded-For apenas atrás de um proxy controlado.
# Use "true" na Vercel ou o número de proxies da sua infraestrutura.
TRUST_PROXY=false

# Destino do redirecionamento de /PorteiroInteligente.apk.
RELEASES_URL=https://github.com/Gledson2012/Porteiro-Inteligente-2026/releases/latest
